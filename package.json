{
  "name": "lighthouse-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "desktop:build": "vue-tsc -b && vite build --base ./ --outDir dist-desktop && tsc -p tsconfig.electron.json",
    "desktop": "bun run desktop:build && electron .",
    "desktop:dev": "tsc -p tsconfig.electron.json && LIGHTHOUSE_DEV_URL=http://localhost:5173 electron .",
    "desktop:package": "bun run desktop:build && electron-builder --dir",
    "desktop:dist": "bun run desktop:build && electron-builder"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@lucide/vue": "^1.70.0",
    "@vueuse/core": "^15.0.0",
    "pixi.js": "^8.22.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "trustedDependencies": [
    "electron"
  ],
  "main": "dist-electron/main.cjs",
  "packageManager": "bun@1.4.4",
  "author": "viirtualp1",
  "description": "A survival town-builder: keep the Lighthouse burning for twenty nights."
}
